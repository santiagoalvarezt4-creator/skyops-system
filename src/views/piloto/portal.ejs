<%- include('../partials/head', { description: 'Portal del piloto en AeroGestión: perfil, licencia, horas de vuelo y vuelos asignados.' }) %>
<%
  const estadoClass = { PROGRAMADO: 'status-info', EN_VUELO: 'status-warn', COMPLETADO: 'status-ok', CANCELADO: 'status-bad' };
  const proximos = vuelos.filter(v => v.estado === 'PROGRAMADO').length;
%>
<body>
  <div class="app-shell">
    <%- include('../partials/navbar') %>

    <main class="container pb-5">
      <header class="page-header">
        <span class="card-eyebrow"><span class="dot"></span> Cabina de mando · Piloto</span>
        <h1>Capitán <%= currentUser.nombres %></h1>
        <p class="text-soft mb-0">Revisa tu información de vuelo y la agenda asignada.</p>
      </header>

      <div class="row g-4">
        <div class="col-lg-4">
          <article class="boarding-pass" aria-label="Credencial del piloto">
            <div class="d-flex justify-content-between align-items-start">
              <div class="kv">
                <small>Piloto</small>
                <span><%= perfil.nombres %> <%= perfil.apellidos %></span>
              </div>
              <i class="bi bi-airplane-fill fs-3 text-sky" style="transform: rotate(45deg); display:inline-block"></i>
            </div>

            <div class="perforation"></div>

            <div class="row g-3">
              <div class="col-6 kv">
                <small>Licencia</small>
                <span><%= perfil.licencia_numero || 'Pendiente' %></span>
              </div>
              <div class="col-6 kv">
                <small>Cédula</small>
                <span><%= perfil.cedula_identidad %></span>
              </div>
              <div class="col-6 kv">
                <small>Base</small>
                <span class="text-amber"><%= perfil.codigo_iata %></span>
              </div>
              <div class="col-6 kv">
                <small>Teléfono</small>
                <span><%= perfil.telefono %></span>
              </div>
              <div class="col-12 kv">
                <small>Aeropuerto base</small>
                <span class="fs-6"><%= perfil.nombre_aeropuerto %>, <%= perfil.nombre_ciudad %></span>
              </div>
            </div>

            <% if (!perfil.licencia_numero) { %>
              <p class="small text-soft mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>Tu licencia aún no ha sido registrada por un administrador.</p>
            <% } %>
          </article>

          <div class="row g-4 mt-0 stagger">
            <div class="col-6">
              <article class="panel stat-card">
                <div class="stat-icon amber"><i class="bi bi-clock-history"></i></div>
                <div class="stat-value"><%= (perfil.horas_vuelo || 0).toLocaleString('es-CO') %></div>
                <div class="stat-label">Horas de vuelo</div>
              </article>
            </div>
            <div class="col-6">
              <article class="panel stat-card">
                <div class="stat-icon"><i class="bi bi-calendar-check"></i></div>
                <div class="stat-value"><%= proximos %></div>
                <div class="stat-label">Próximos vuelos</div>
              </article>
            </div>
          </div>
        </div>

        <div class="col-lg-8">
          <section class="panel" aria-labelledby="flights-title">
            <div class="mb-3">
              <h2 id="flights-title" class="h5 mb-1">Vuelos asignados</h2>
              <p class="text-muted-aero small mb-0">Itinerario completo de tus operaciones.</p>
            </div>

            <% if (vuelos.length) { %>
              <div class="table-responsive">
                <table class="table table-aero table-hover">
                  <thead>
                    <tr>
                      <th>Vuelo</th>
                      <th>Ruta</th>
                      <th>Salida</th>
                      <th>Aeronave</th>
                      <th class="text-end">Estado</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% vuelos.forEach(v => { %>
                      <tr>
                        <td class="font-display fw-bold text-sky"><%= v.codigo_vuelo %></td>
                        <td>
                          <span class="route-pill" title="<%= v.ciudad_origen %> → <%= v.ciudad_destino %>">
                            <%= v.origen %><span class="line"><i class="bi bi-airplane-fill"></i></span><%= v.destino %>
                          </span>
                        </td>
                        <td class="lh-sm">
                          <div class="fw-semibold"><%= v.fecha_salida %></div>
                          <small class="text-muted-aero"><%= v.hora_salida %> – <%= v.hora_llegada %></small>
                        </td>
                        <td class="lh-sm">
                          <div class="fw-semibold"><%= v.matricula %></div>
                          <small class="text-muted-aero"><%= v.modelo %></small>
                        </td>
                        <td class="text-end"><span class="status <%= estadoClass[v.estado] || 'status-info' %>"><%= v.estado.replace('_', ' ') %></span></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state">
                <i class="bi bi-cloud-sun"></i>
                No tienes vuelos asignados por ahora. ¡Cielos despejados!
              </div>
            <% } %>
          </section>
        </div>
      </div>
    </main>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>
