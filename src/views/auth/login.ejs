<%- include('../partials/head', { description: 'Inicia sesión en AeroGestión para acceder al panel de operaciones aéreas según tu perfil.' }) %>
<body>
  <div class="auth-shell">
    <%- include('../partials/auth-hero') %>

    <main class="auth-main">
      <section class="glass-card" aria-labelledby="login-title">
        <a href="/login" class="brand d-lg-none mb-4">
          <span class="brand-mark"><i class="bi bi-airplane-fill"></i></span>
          <span>Aero<em>Gestión</em></span>
        </a>

        <span class="card-eyebrow"><span class="dot"></span> Torre de control en línea</span>
        <h1 id="login-title" class="card-title">Bienvenido a bordo</h1>
        <p class="card-subtitle">Ingresa tus credenciales para acceder a tu cabina.</p>

        <form id="login-form" action="/login" method="POST" data-validate novalidate>
          <div class="mb-3 field">
            <label for="email" class="form-label">Correo electrónico</label>
            <div class="input-aero">
              <i class="bi bi-envelope lead"></i>
              <input type="email" class="form-control" id="email" name="email" value="<%= old.email || '' %>"
                     placeholder="nombre@aerolinea.com" autocomplete="email" required
                     data-rule="email" data-label="Correo electrónico" autofocus>
            </div>
          </div>

          <div class="mb-2 field">
            <label for="password" class="form-label">Contraseña</label>
            <div class="input-aero">
              <i class="bi bi-lock lead"></i>
              <input type="password" class="form-control pe-5" id="password" name="password"
                     placeholder="••••••••" autocomplete="current-password" required data-label="Contraseña">
              <button type="button" class="toggle-password" id="toggle-password" data-toggle-password="#password" aria-label="Mostrar contraseña">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <div class="d-flex justify-content-end mb-4">
            <a href="/forgot-password" id="link-forgot" class="small">¿Olvidaste tu contraseña?</a>
          </div>

          <button type="submit" id="btn-login" class="btn btn-aero w-100">
            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
          </button>
        </form>

        <div class="divider">¿Nuevo en la tripulación?</div>

        <a href="/register" id="link-register" class="btn btn-ghost w-100 py-2">
          <i class="bi bi-person-plus me-2"></i>Crear una cuenta
        </a>
      </section>
    </main>
  </div>

  <%- include('../partials/scripts', { withValidation: true }) %>
</body>
</html>
