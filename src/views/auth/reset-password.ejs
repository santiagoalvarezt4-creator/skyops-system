<%- include('../partials/head', { description: 'Define una nueva contraseña para tu cuenta de AeroGestión.' }) %>
<body>
  <div class="auth-shell">
    <%- include('../partials/auth-hero') %>

    <main class="auth-main">
      <section class="glass-card" aria-labelledby="reset-title">
        <span class="card-eyebrow"><span class="dot"></span> Enlace verificado</span>
        <h1 id="reset-title" class="card-title">Nueva contraseña</h1>
        <p class="card-subtitle">Elige una contraseña segura: mínimo 8 caracteres con letras y números.</p>

        <form id="reset-form" action="/reset-password/<%= token %>" method="POST" data-validate novalidate>
          <div class="mb-3 field">
            <label for="password" class="form-label">Nueva contraseña</label>
            <div class="input-aero">
              <i class="bi bi-lock lead"></i>
              <input type="password" class="form-control pe-5" id="password" name="password" placeholder="Mín. 8, letras y números"
                     autocomplete="new-password" maxlength="72" required data-rule="password" data-label="Nueva contraseña"
                     data-meter="#password-meter" autofocus>
              <button type="button" class="toggle-password" data-toggle-password="#password" aria-label="Mostrar contraseña">
                <i class="bi bi-eye"></i>
              </button>
            </div>
            <div class="password-meter" id="password-meter"><span></span></div>
          </div>

          <div class="mb-4 field">
            <label for="confirm_password" class="form-label">Confirmar contraseña</label>
            <div class="input-aero">
              <i class="bi bi-lock-fill lead"></i>
              <input type="password" class="form-control pe-5" id="confirm_password" name="confirm_password"
                     placeholder="Repite la contraseña" autocomplete="new-password" maxlength="72" required
                     data-match="#password" data-label="Confirmar contraseña">
              <button type="button" class="toggle-password" data-toggle-password="#confirm_password" aria-label="Mostrar contraseña">
                <i class="bi bi-eye"></i>
              </button>
            </div>
          </div>

          <button type="submit" id="btn-reset" class="btn btn-aero w-100">
            <i class="bi bi-check2-circle me-2"></i>Restablecer contraseña
          </button>
        </form>
      </section>
    </main>
  </div>

  <%- include('../partials/scripts', { withValidation: true }) %>
</body>
</html>
