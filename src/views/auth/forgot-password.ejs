<%- include('../partials/head', { description: 'Recupera el acceso a tu cuenta de AeroGestión mediante un enlace seguro y temporal.' }) %>
<body>
  <div class="auth-shell">
    <%- include('../partials/auth-hero') %>

    <main class="auth-main">
      <section class="glass-card" aria-labelledby="forgot-title">
        <a href="/login" class="brand d-lg-none mb-4">
          <span class="brand-mark"><i class="bi bi-airplane-fill"></i></span>
          <span>Aero<em>Gestión</em></span>
        </a>

        <span class="card-eyebrow"><span class="dot"></span> Procedimiento de recuperación</span>
        <h1 id="forgot-title" class="card-title">¿Perdiste el rumbo?</h1>
        <p class="card-subtitle">Ingresa el correo asociado a tu cuenta y te enviaremos un enlace temporal para restablecer tu contraseña.</p>

        <form id="forgot-form" action="/forgot-password" method="POST" data-validate novalidate>
          <div class="mb-4 field">
            <label for="email" class="form-label">Correo electrónico</label>
            <div class="input-aero">
              <i class="bi bi-envelope lead"></i>
              <input type="email" class="form-control" id="email" name="email" value="<%= old.email || '' %>"
                     placeholder="nombre@aerolinea.com" autocomplete="email" required
                     data-rule="email" data-label="Correo electrónico" autofocus>
            </div>
          </div>

          <button type="submit" id="btn-forgot" class="btn btn-aero w-100">
            <i class="bi bi-send me-2"></i>Enviar enlace de recuperación
          </button>
        </form>

        <a href="/login" id="link-back-login" class="btn btn-ghost w-100 py-2 mt-3">
          <i class="bi bi-arrow-left me-2"></i>Volver al inicio de sesión
        </a>
      </section>
    </main>
  </div>

  <%- include('../partials/scripts', { withValidation: true }) %>
</body>
</html>
