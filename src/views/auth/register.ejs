<%- include('../partials/head', { description: 'Crea tu cuenta en AeroGestión y únete a la plataforma de gestión de operaciones aéreas.' }) %>
<body>
  <div class="auth-shell">
    <%- include('../partials/auth-hero') %>

    <main class="auth-main">
      <section class="glass-card wide" aria-labelledby="register-title">
        <a href="/login" class="brand d-lg-none mb-4">
          <span class="brand-mark"><i class="bi bi-airplane-fill"></i></span>
          <span>Aero<em>Gestión</em></span>
        </a>

        <span class="card-eyebrow"><span class="dot"></span> Registro de personal</span>
        <h1 id="register-title" class="card-title">Únete a la tripulación</h1>
        <p class="card-subtitle">Completa tus datos para generar tu credencial de acceso.</p>

        <form id="register-form" action="/register" method="POST" data-validate novalidate>
          <div class="section-label"><i class="bi bi-person-vcard"></i> Datos personales</div>
          <div class="row g-3 mb-4">
            <div class="col-md-6 field">
              <label for="cedula" class="form-label">Cédula</label>
              <div class="input-aero">
                <i class="bi bi-credit-card-2-front lead"></i>
                <input type="text" inputmode="numeric" class="form-control" id="cedula" name="cedula"
                       value="<%= old.cedula || '' %>" placeholder="1020304050" maxlength="20" required
                       data-rule="digits" data-min="5" data-max="20" data-label="Cédula">
              </div>
            </div>
            <div class="col-md-6 field">
              <label for="telefono" class="form-label">Teléfono</label>
              <div class="input-aero">
                <i class="bi bi-telephone lead"></i>
                <input type="tel" inputmode="numeric" class="form-control" id="telefono" name="telefono"
                       value="<%= old.telefono || '' %>" placeholder="3001234567" maxlength="20" required
                       data-rule="digits" data-min="7" data-max="20" data-label="Teléfono">
              </div>
            </div>
            <div class="col-md-6 field">
              <label for="nombres" class="form-label">Nombres</label>
              <div class="input-aero">
                <i class="bi bi-person lead"></i>
                <input type="text" class="form-control" id="nombres" name="nombres" value="<%= old.nombres || '' %>"
                       placeholder="Ana María" maxlength="100" autocomplete="given-name" required
                       data-rule="letters" data-label="Nombres">
              </div>
            </div>
            <div class="col-md-6 field">
              <label for="apellidos" class="form-label">Apellidos</label>
              <div class="input-aero">
                <i class="bi bi-person lead"></i>
                <input type="text" class="form-control" id="apellidos" name="apellidos" value="<%= old.apellidos || '' %>"
                       placeholder="Gómez Restrepo" maxlength="100" autocomplete="family-name" required
                       data-rule="letters" data-label="Apellidos">
              </div>
            </div>
            <div class="col-md-7 field">
              <label for="direccion" class="form-label">Dirección</label>
              <div class="input-aero">
                <i class="bi bi-geo-alt lead"></i>
                <input type="text" class="form-control" id="direccion" name="direccion" value="<%= old.direccion || '' %>"
                       placeholder="Calle 26 # 103-09" maxlength="200" autocomplete="street-address" required
                       data-min="5" data-max="200" data-label="Dirección">
              </div>
            </div>
            <div class="col-md-5 field">
              <label for="id_base" class="form-label">Base de operaciones</label>
              <div class="input-aero">
                <i class="bi bi-buildings lead"></i>
                <select class="form-select" id="id_base" name="id_base" required data-label="Base de operaciones">
                  <option value="">Selecciona...</option>
                  <% bases.forEach(b => { %>
                    <option value="<%= b.id_base %>" <%= String(old.id_base) === String(b.id_base) ? 'selected' : '' %>>
                      <%= b.codigo_iata %> · <%= b.nombre_ciudad %>
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>
          </div>

          <div class="section-label"><i class="bi bi-shield-lock"></i> Credenciales de acceso</div>
          <div class="row g-3 mb-4">
            <div class="col-12 field">
              <label for="email" class="form-label">Correo electrónico</label>
              <div class="input-aero">
                <i class="bi bi-envelope lead"></i>
                <input type="email" class="form-control" id="email" name="email" value="<%= old.email || '' %>"
                       placeholder="nombre@aerolinea.com" maxlength="150" autocomplete="email" required
                       data-rule="email" data-label="Correo electrónico">
              </div>
            </div>
            <div class="col-md-6 field">
              <label for="password" class="form-label">Contraseña</label>
              <div class="input-aero">
                <i class="bi bi-lock lead"></i>
                <input type="password" class="form-control pe-5" id="password" name="password" placeholder="Mín. 8, letras y números"
                       autocomplete="new-password" maxlength="72" required data-rule="password" data-label="Contraseña"
                       data-meter="#password-meter">
                <button type="button" class="toggle-password" data-toggle-password="#password" aria-label="Mostrar contraseña">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
              <div class="password-meter" id="password-meter"><span></span></div>
            </div>
            <div class="col-md-6 field">
              <label for="confirm_password" class="form-label">Confirmar contraseña</label>
              <div class="input-aero">
                <i class="bi bi-lock-fill lead"></i>
                <input type="password" class="form-control pe-5" id="confirm_password" name="confirm_password"
                       placeholder="Repite la contraseña" autocomplete="new-password" maxlength="72" required
                       data-match="#password" data-label="Confirmar contraseña">
                <button type="button" class="toggle-password" data-toggle-password="#confirm_password" aria-label="Mostrar contraseña">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>
          </div>

          <button type="submit" id="btn-register" class="btn btn-aero w-100">
            <i class="bi bi-person-check me-2"></i>Crear cuenta
          </button>
        </form>

        <p class="text-center text-soft mt-4 mb-0 small">
          ¿Ya tienes cuenta? <a href="/login" id="link-login" class="fw-semibold">Inicia sesión</a>
        </p>
      </section>
    </main>
  </div>

  <%- include('../partials/scripts', { withValidation: true }) %>
</body>
</html>
